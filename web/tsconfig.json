{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@tusalud/environment": ["environments/environment.ts"],
      "@tusalud/core/testing": ["projects/core/src/testing/index.ts"],
      "@tusalud/core": ["projects/core/src/public-api.ts"],
      "@tusalud/ui/*": ["projects/ui/*/src/public-api.ts"],
      "@tusalud/features/*": ["projects/features/*/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": []
}
