server {
    listen 8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    open_file_cache max=1000 inactive=60s;
    open_file_cache_valid 60s;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location ~* \.map$ {
        return 404;
    }

    location ~ ^/(paciente|medico|admin|gerencia|finanzas|operaciones|calidad|rrhh|recepcion|caja|enfermeria|laboratorio|imagenes|farmacia|almacen)$ {
        return 301 /$1/$is_args$args;
    }

    location ~ ^/(?:paciente|medico|admin|gerencia|finanzas|operaciones|calidad|rrhh|recepcion|caja|enfermeria|laboratorio|imagenes|farmacia|almacen)/index\.html$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    location ~* "-[A-Z0-9]{8}\.(?:js|css)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:ico|png|jpe?g|gif|svg|webp|avif|woff2?)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location ~ ^/(paciente|medico|admin|gerencia|finanzas|operaciones|calidad|rrhh|recepcion|caja|enfermeria|laboratorio|imagenes|farmacia|almacen)/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /$1/index.html;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
