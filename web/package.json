{
  "name": "tusalud",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration local",
    "start:dev": "ng serve --configuration dev",
    "build": "ng build --configuration production",
    "build:local": "ng build --configuration local",
    "build:dev": "ng build --configuration dev",
    "build:qa": "ng build --configuration qa",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration local",
    "test": "ng test tusalud --watch=false",
    "test:watch": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:core": "ng test core --watch=false",
    "test:ui": "ng test ui --watch=false",
    "test:all": "ng test core --watch=false && ng test ui --watch=false && ng test features --watch=false && ng test tusalud --watch=false",
    "build:libs": "ng build core && ng build ui && ng build features",
    "test:features": "ng test features --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^3.1.1",
    "chart.js": "^4.6.1",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.65.1",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
