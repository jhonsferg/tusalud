resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
access_log /dev/stdout tusalud;

client_max_body_size ${GATEWAY_MAX_BODY_DEFAULT};
client_header_buffer_size 4k;
large_client_header_buffers 4 16k;
client_header_timeout 15s;
client_body_timeout 30s;
send_timeout 120s;
keepalive_timeout 30s;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {
    return 405;
}

location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store" always;
    return 200 "ok";
}

location = /healthz/web {
    access_log off;
    set $front_salud ${FRONT_UPSTREAM};
    proxy_pass $front_salud/healthz;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
}

location = /healthz/api {
    access_log off;
    set $api_salud ${API_UPSTREAM};
    rewrite ^ /v3/api-docs break;
    proxy_pass $api_salud;
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
}

location = /storage {
    return 404;
}

location ^~ /storage/ {
    return 404;
}

location ~ /\.(?!well-known/) {
    return 404;
}

location ~* \.map$ {
    return 404;
}

location = /api/v1/notificaciones/stream {
    include /etc/nginx/conf.d/cabeceras.inc;
    add_header X-Accel-Buffering no always;
    set $api_stream ${API_UPSTREAM};
    proxy_pass $api_stream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 1h;
    proxy_hide_header X-Powered-By;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Strict-Transport-Security;
}

location = /ws/teleconsulta {
    limit_req zone=general burst=${RATE_BURST_GENERAL} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    set $api_ws ${API_UPSTREAM};
    proxy_pass $api_ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_buffering off;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 2h;
    proxy_send_timeout 2h;
    proxy_hide_header X-Powered-By;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Strict-Transport-Security;
}

location = /api/v1/auth/login {
    limit_req zone=login burst=${RATE_BURST_AUTH} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location = /api/v1/auth/refresh {
    limit_req zone=refresh burst=${RATE_BURST_AUTH} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location = /api/v1/auth/register {
    limit_req zone=registro burst=${RATE_BURST_AUTH} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location ~ ^/api/v1/auth/mfa/(verificar|activar|desactivar|codigos-recuperacion/regenerar)$ {
    limit_req zone=mfa burst=${RATE_BURST_AUTH} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location = /api/v1/perfil/password {
    limit_req zone=login burst=${RATE_BURST_AUTH} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location ~ ^/api/v1/(archivos|imagenes/ordenes/[^/]+/archivos|perfil/avatar)$ {
    client_max_body_size ${GATEWAY_MAX_BODY_UPLOAD};
    limit_req zone=general burst=${RATE_BURST_GENERAL} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location ~ ^/(swagger-ui(\.html|/.*)?|v3/api-docs(/.*)?)$ {
    if ($docs_cerradas) {
        return 404;
    }
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location /api/ {
    limit_req zone=general burst=${RATE_BURST_GENERAL} nodelay;
    include /etc/nginx/conf.d/cabeceras.inc;
    include /etc/nginx/conf.d/proxy-api.inc;
}

location / {
    include /etc/nginx/conf.d/cabeceras-front.inc;
    include /etc/nginx/conf.d/proxy-front.inc;
}
